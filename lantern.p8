pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
-- lantern
-- a tiny miner, a dying lamp,
-- and a very deep hole.

-------------------------------
-- constants (tweak these!)
-------------------------------

-- tile ids. each one is also
-- the sprite number that draws
-- it, so map() just works.
t_empty=0
t_dirt=1
t_rock=2
t_gem1=3 -- green (shallow)
t_gem3=5 -- red (deep)
t_oil=6

cols=16 -- tiles across
rows=15 -- tiles down
top=8   -- map starts 8px down,
        -- leaving room for hud

oil_max=100
oil_drain=0.075 -- per frame
                -- (~44 seconds)
oil_can=35      -- refill amount
bat_cost=15     -- oil lost to bat

-------------------------------
-- init / reset
-------------------------------

-- pico-8 calls _init once
-- when the cart starts.
function _init()
 start_game()
end

function start_game()
 mode="play" -- "play" or "over"
 score=0
 screen=0    -- screens descended
 oil=oil_max
 fr=0        -- frame counter
 pops={}     -- floating "+10"s

 -- the miner. x,y are tile
 -- coords; px,py are pixel
 -- coords that slide toward
 -- the tile so moves look
 -- smooth.
 p={
  x=7,y=0,
  px=56,py=top,
  dx=1,dy=0,  -- aim direction
  flip=false, -- face left?
  spd=1,      -- pixels/frame
  anim=0,     -- walk frame
  hurt=0,     -- flash timer
  want_dig=false
 }

 gen_screen()
 -- the first screen gets an
 -- open surface row to start on
 for x=0,cols-1 do
  mset(x,0,t_empty)
 end
end

-------------------------------
-- level generation
-------------------------------

-- fill the map with a fresh
-- random screen for the
-- current depth.
function gen_screen()
 -- deeper = more rock and
 -- gems, fewer oil cans
 local rock_ch=min(0.08+screen*0.01,0.2)
 local gem_ch=min(0.025+screen*0.004,0.06)
 local oil_ch=max(0.008,0.02-screen*0.0015)

 for y=0,rows-1 do
  for x=0,cols-1 do
   local t=t_dirt
   local r=rnd(1)
   if r<rock_ch and rock_ok(x,y) then
    t=t_rock
   elseif r<rock_ch+gem_ch then
    t=pick_gem()
   elseif r<rock_ch+gem_ch+oil_ch then
    t=t_oil
   end
   mset(x,y,t)
  end
 end

 -- a few small open caves
 for i=1,2+rnd(3) do
  carve(flr(rnd(cols)),
        flr(rnd(rows)),
        1+flr(rnd(4)))
 end

 -- bats, each in its own
 -- little tunnel to patrol
 bats={}
 for i=1,min(1+screen\2,4) do
  local bx=flr(rnd(cols-4))
  local by=2+flr(rnd(rows-3))
  carve(bx,by,4)
  add(bats,{
   x=bx*8,
   y=top+by*8,
   dir=rnd(1)<0.5 and 1 or -1,
   spd=0.5+rnd(0.3)+screen*0.03
  })
 end
end

-- rocks may stack vertically
-- but never touch another rock
-- sideways or diagonally. that
-- way the miner can always
-- step aside and dig down, so
-- he can never get boxed in.
-- we fill row by row, so only
-- neighbors already placed
-- need checking.
function rock_ok(x,y)
 return mget(x-1,y)!=t_rock
    and mget(x-1,y-1)!=t_rock
    and mget(x+1,y-1)!=t_rock
end

-- deeper screens roll a bigger
-- number, so better gems
-- become more likely.
function pick_gem()
 local r=rnd(screen+2)
 if (r<2) return t_gem1
 if (r<5) return t_gem1+1
 return t_gem3
end

-- clear a horizontal run of
-- tiles (clamped to the screen)
function carve(x,y,len)
 for i=0,len-1 do
  mset(min(x+i,cols-1),y,t_empty)
 end
end

-------------------------------
-- update
-------------------------------

-- pico-8 calls _update 30
-- times a second.
function _update()
 fr+=1
 if mode=="play" then
  update_play()
 else
  update_over()
 end
end

function update_play()
 -- the lamp always burns
 oil-=oil_drain
 if (p.hurt>0) p.hurt-=1
 if oil<=0 then
  lamp_out()
  return
 end

 -- remember dig presses even
 -- mid-step, so they're not lost
 if (btnp(5)) p.want_dig=true

 -- slide toward the target
 -- tile; only act once there
 local tx,ty=p.x*8,top+p.y*8
 if p.px!=tx or p.py!=ty then
  p.px=approach(p.px,tx,p.spd)
  p.py=approach(p.py,ty,p.spd)
  if (p.px!=tx) p.anim+=1
 else
  settled()
 end

 update_bats()
 update_pops()
end

-- the miner is standing exactly
-- on a tile: apply gravity,
-- then read input.
function settled()
 -- fell off the bottom?
 if p.y>=rows then
  next_screen()
  return
 end

 -- gravity: nothing below = fall
 if not solid(p.x,p.y+1) then
  p.y+=1
  p.spd=2
  return
 end
 p.spd=1

 -- arrows aim. left/right
 -- also walk if the way is clear.
 if btn(0) then
  p.dx,p.dy,p.flip=-1,0,true
 elseif btn(1) then
  p.dx,p.dy,p.flip=1,0,false
 elseif btn(3) then
  p.dx,p.dy=0,1
 end

 if p.want_dig then
  p.want_dig=false
  dig()
 elseif (btn(0) or btn(1))
    and not solid(p.x+p.dx,p.y) then
  p.x+=p.dx
 end
end

-- dig the tile we're aiming at,
-- collecting anything buried in it.
function dig()
 local x,y=p.x+p.dx,p.y+p.dy
 -- off the sides of the screen
 if (x<0 or x>=cols or y>=rows) return
 local t=mget(x,y)
 if (t==t_empty) return
 if t==t_rock then
  sfx(5) -- clunk
  return
 end

 if t>=t_gem1 and t<=t_gem3 then
  -- better gem and deeper
  -- screen = more points
  local v=(t-t_gem1+1)*10+screen*5
  score+=v
  pop("+"..v,10)
  sfx(1)
 elseif t==t_oil then
  oil=min(oil+oil_can,oil_max)
  pop("oil!",9)
  sfx(2)
 else
  sfx(0)
 end
 mset(x,y,t_empty)
end

function next_screen()
 screen+=1
 gen_screen()
 -- drop in from above row 0,
 -- with a hole to land in
 p.y=0
 p.py=top-8
 mset(p.x,0,t_empty)
end

function update_bats()
 for b in all(bats) do
  local nx=b.x+b.dir*b.spd
  -- check the tile at the
  -- bat's leading edge
  local ex=nx
  if (b.dir>0) ex=nx+7
  if solid(flr(ex/8),(b.y-top)\8) then
   b.dir=-b.dir -- turn around
  else
   b.x=nx
  end

  -- bumped the miner? (skip
  -- while he's still flashing)
  if p.hurt==0
     and abs(b.x-p.px)<6
     and abs(b.y-p.py)<6 then
   oil-=bat_cost
   p.hurt=45
   b.dir=-b.dir
   pop("-oil",8)
   sfx(3)
  end
 end
end

-- floating text above the miner
function pop(txt,col)
 add(pops,{x=p.px,y=p.py-4,
  txt=txt,col=col,life=24})
end

function update_pops()
 for o in all(pops) do
  o.y-=0.5
  o.life-=1
  if (o.life<=0) del(pops,o)
 end
end

function lamp_out()
 mode="over"
 oil=0
 over_t=0
 sfx(4)
end

function update_over()
 over_t+=1
 -- short pause so a held x
 -- doesn't skip this screen
 if over_t>30 and (btnp(4) or btnp(5)) then
  start_game()
 end
end

-------------------------------
-- draw
-------------------------------

-- pico-8 calls _draw after
-- each _update.
function _draw()
 cls(0)
 if mode=="over" then
  draw_over()
  return
 end

 -- the whole screen of tiles
 -- in one call, from map memory
 map(0,0,0,top,cols,rows)

 -- bats bob and flap
 for b in all(bats) do
  spr(9+(fr\4)%2,b.x,
      b.y+sin(fr/30+b.x/64))
 end

 -- miner: blink while hurt
 if p.hurt%4<2 then
  local s=7+(p.anim\4)%2
  if (p.dy==1) s=11
  spr(s,p.px,p.py,1,1,p.flip)
 end

 darkness()

 -- popups drawn after the
 -- dark so they always show
 for o in all(pops) do
  print(o.txt,o.x,o.y,o.col)
 end

 draw_hud()
end

-- black out everything outside
-- a circle around the miner.
-- radius shrinks with oil.
function darkness()
 local cx,cy=p.px+4,p.py+4
 local r=10+50*oil/oil_max
 -- small flicker, like a flame
 r+=sin(fr/20)*0.8

 -- pass 1: checkerboard dither
 -- for a soft dim edge. the .1
 -- makes the pattern's 1-bits
 -- transparent.
 fillp(0b0101101001011010.1)
 for y=top,127 do
  shade_row(y,cx,cy,r)
 end
 fillp()

 -- pass 2: solid black a bit
 -- further out
 for y=top,127 do
  shade_row(y,cx,cy,r+6)
 end
end

-- on row y, fill black to the
-- left and right of the circle
-- (or the whole row if the
-- circle doesn't reach it).
function shade_row(y,cx,cy,r)
 local dy=y-cy
 local w=r*r-dy*dy
 if w<0 then
  rectfill(0,y,127,y,0)
 else
  w=sqrt(w)
  rectfill(0,y,cx-w,y,0)
  rectfill(cx+w,y,127,y,0)
 end
end

function draw_hud()
 rectfill(0,0,127,7,0)
 print(depth().."m",1,1,6)
 print("score "..score,30,1,10)

 -- oil bar, blinking red
 -- when it's nearly empty
 print("oil",80,1,9)
 rect(93,1,126,5,5)
 local w=flr(32*oil/oil_max)
 local c=9
 if (oil<25 and fr%16<8) c=8
 if (w>0) rectfill(94,2,93+w,4,c)
end

function draw_over()
 cprint("lamp out",40,8)
 cprint("depth "..depth().."m",56,6)
 cprint("score "..score,64,10)
 if over_t>30 and fr%30<20 then
  cprint("press x to dig again",88,5)
 end
end

-------------------------------
-- helpers
-------------------------------

-- is tile x,y blocked? screen
-- sides are walls, but the
-- bottom is open (that's the
-- way down).
function solid(x,y)
 if (x<0 or x>=cols) return true
 if (y>=rows) return false
 return mget(x,y)!=t_empty
end

-- depth in meters (1 tile = 1m)
function depth()
 return screen*rows+min(p.y,rows-1)
end

-- move a toward b by at most s
function approach(a,b,s)
 if (a<b) return min(a+s,b)
 return max(a-s,b)
end

-- print centered horizontally
-- (each character is 4px wide)
function cprint(s,y,c)
 print(s,64-#s*2,y,c)
end
